FROM apache/airflow:2.10.4-python3.11

# 1. Packages système en root
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ \
    && rm -rf /var/lib/apt/lists/*

# 2. Packages Python en tant qu'airflow (obligatoire pour cette image)
USER airflow
COPY docker/requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt

# 3. Entrypoint copié et exécuté en root (pour corriger les permissions des volumes)
USER root
COPY docker/airflow-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
