# MLflow — backend SQLite local (supporte le Model Registry)
# Lance "make mlflow_ui" pour visualiser sur http://127.0.0.1:5000
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT=ibm-hr-attrition
MODEL_NAME=attrition-classifier

# Niveau de déploiement par défaut pour le Model Registry
# Valeurs possibles : champion, challenger
DEPLOY_STAGE=challenger
